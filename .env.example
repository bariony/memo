DATABASE_URL=postgresql://user:pass@localhost:5432/memo
REDIS_URL=redis://localhost:6379
CLAUDE_API_KEY=sk-...
EVOLUTION_INSTANCE=your_instance
EVOLUTION_API_KEY=your_key
ADMIN_PASSWORD=change_me_in_prod
# Signing key for admin session tokens. Optional - falls back to
# ADMIN_PASSWORD if unset, but set a long random value in production so the
# login password and the token-signing key aren't the same secret.
JWT_SECRET=change_me_to_a_long_random_string_in_prod
# WhatsApp number that receives access-request notifications and can
# approve/deny them by replying "aprovar <numero>" / "negar <numero>".
# Optional - defaults to 11986683737 if unset.
ADMIN_PHONE_NUMBER=11986683737
NODE_ENV=development
PORT=3000
